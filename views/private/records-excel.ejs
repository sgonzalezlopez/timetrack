<link rel="stylesheet" href="/css/records-excel.css?v=2">
<div class="modal fade" id="RecordsExcelModal" tabindex="-1" aria-labelledby="RecordsExcelTitle" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="RecordsExcelTitle"><%= __('RECORDS_EXCEL_UPDATE') %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= __('CLOSE') %>"></button>
        </div>
        <div class="modal-body">
            <p id="RecordsExcel_help"><%= __('RECORDS_EXCEL_HELP') %></p>
            <button type="button" class="btn btn-secondary" id="RecordsExcel_folder"><%= __('RECORDS_EXCEL_FOLDER') %></button>
            <label for="RecordsExcel_file" class="d-block mt-3"><%= __('IMPORT_FILE') %></label>
            <select id="RecordsExcel_file" class="form-select"></select>
            <div id="RecordsExcel_message" class="alert mt-3" role="alert" tabindex="-1" style="white-space: pre-line; overflow-wrap: anywhere; max-height: 50vh; overflow-y: auto" hidden></div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-maroon" id="RecordsExcel_save" disabled><%= __('RECORDS_EXCEL_UPDATE') %></button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= __('CLOSE') %></button>
        </div>
    </div></div>
</div>
<script>
    window.recordsExcelText = <%- JSON.stringify(Object.fromEntries([
        'RECORDS_EXCEL_UNSUPPORTED', 'RECORDS_EXCEL_CONFIRM', 'RECORDS_EXCEL_SAVED',
        'RECORDS_EXCEL_ERROR', 'RECORDS_EXCEL_NO_FILES', 'RECORDS_EXCEL_BACKUP', 'RECORDS_EXCEL_CHANGED',
        'RECORDS_EXCEL_UPDATE', 'RECORDS_EXCEL_HELP', 'RECORDS_CATEGORIES_UPDATE',
        'RECORDS_CATEGORIES_HELP', 'RECORDS_CATEGORIES_CONFIRM',
        'RECORDS_ALLROUND_UPDATE', 'RECORDS_ALLROUND_HELP', 'RECORDS_ALLROUND_CONFIRM'
    ].map(key => [key, __(key)]))).replace(/</g, '\\u003c') %>;
</script>
<script src="/js/records-excel.js"></script>
