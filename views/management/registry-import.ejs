<div class="modal fade" id="RegistryImportModal" tabindex="-1" aria-labelledby="RegistryImportTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="RegistryImportTitle"><%= __('IMPORT_TITLE') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= __('CLOSE') %>"></button>
            </div>
            <div class="modal-body">
                <p><%= __(locals.registryImportScope === 'registry' ? 'IMPORT_REGISTRY_HELP' : 'IMPORT_HELP') %></p>
                <form id="RegistryImportForm">
                    <label for="RegistryImportFormat"><%= __('IMPORT_FORMAT') %></label>
                    <select class="form-select mb-3" id="RegistryImportFormat" name="format" required></select>
                    <label for="RegistryImportFile"><%= __('IMPORT_FILE') %></label>
                    <input class="form-control mb-3" type="file" id="RegistryImportFile" name="file" required />
                    <label for="RegistryImportCategorySource"><%= __('IMPORT_CATEGORY_SOURCE') %></label>
                    <select class="form-select mb-2" id="RegistryImportCategorySource" name="categorySource">
                        <option value="file"><%= __('IMPORT_CATEGORY_FILE') %></option>
                        <option value="database"><%= __('IMPORT_CATEGORY_DATABASE') %></option>
                    </select>
                    <p class="small"><%= __('IMPORT_CATEGORY_SOURCE_HELP') %></p>
                    <label class="d-block">
                        <input type="checkbox" id="RegistryImportClubOnly" />
                        <%= __('IMPORT_CLUB_ONLY') %>
                    </label>
                    <div class="mb-3">
                        <select class="form-select" id="RegistryImportClub" aria-label="<%= __('COL_club') %>" disabled></select>
                    </div>
                    <label>
                        <input type="checkbox" id="RegistryImportCreate" />
                        <%= __('IMPORT_CREATE_SKATERS') %>
                    </label>
                    <button type="submit" class="btn btn-primary ms-2" id="RegistryImportPreview"><%= __('IMPORT_REVIEW') %></button>
                </form>
                <div class="alert alert-danger mt-3" id="RegistryImportError" role="alert" tabindex="-1" hidden></div>
                <div id="RegistryImportReview" class="mt-3" hidden>
                    <label for="RegistryImportUpdateCategories"><%= __('IMPORT_CATEGORY_UPDATE_CHOOSE') %></label>
                    <select id="RegistryImportUpdateCategories" class="form-select mb-3">
                        <option value=""><%= __('IMPORT_SELECT') %></option>
                        <option value="yes"><%= __('IMPORT_CATEGORY_UPDATE_YES') %></option>
                        <option value="no"><%= __('IMPORT_CATEGORY_UPDATE_NO') %></option>
                    </select>
                    <div id="RegistryImportTracks"></div>
                    <div id="RegistryImportDuplicates" class="alert alert-warning" tabindex="-1" hidden></div>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead><tr>
                                <th><%= __('IMPORT_ROW') %></th>
                                <th><%= __('MODEL_Skater') %></th>
                                <th><%= __('COL_race') %></th>
                                <th><%= __('COL_category') %></th>
                                <th><%= __('IMPORT_ACTION') %></th>
                                <th><%= __('IMPORT_DETAILS') %></th>
                            </tr></thead>
                            <tbody id="RegistryImportRows"></tbody>
                        </table>
                    </div>
                    <button type="button" class="btn btn-primary" id="RegistryImportCommit"><%= __('IMPORT_CONFIRM') %></button>
                </div>
                <div id="RegistryImportReport" class="mt-3" tabindex="-1" hidden></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= __('CLOSE') %></button>
            </div>
        </div>
    </div>
</div>
<script>
    window.registryImportText = <%- JSON.stringify(Object.fromEntries([
        'IMPORT_INVALID_FILE', 'IMPORT_BUSY', 'IMPORT_INVALID_SKATER', 'IMPORT_INVALID_DATE',
        'IMPORT_INVALID_RACE', 'IMPORT_INVALID_TIMES', 'IMPORT_SPECIAL_RESULT', 'IMPORT_UNKNOWN_CLUB',
        'IMPORT_NO_REFERENCE', 'IMPORT_SKIPPED', 'IMPORT_DUPLICATE', 'IMPORT_ROW_FAILED',
        'IMPORT_CATEGORY_SUBSTITUTED', 'IMPORT_SELECT', 'IMPORT_NEW', 'IMPORT_SKIP',
        'IMPORT_SAVE', 'IMPORT_REPLACE', 'IMPORT_ERROR', 'IMPORT_NO_FORMATS', 'IMPORT_CONFIRM_REPLACE',
        'IMPORT_IMPORTED', 'IMPORT_OMITTED', 'IMPORT_FAILED', 'IMPORT_CREATED', 'IMPORT_COMPETITION_MISMATCH',
        'IMPORT_CHOOSE', 'IMPORT_EXPIRED', 'IMPORT_MISSING_TIMES',
        'IMPORT_DATE', 'IMPORT_DISTANCE', 'IMPORT_MISSING_FIELDS', 'IMPORT_NOTHING_SELECTED',
        'IMPORT_CHOOSE_TRACK', 'IMPORT_MISSING_COMPETITION', 'IMPORT_AMBIGUOUS_EVENT',
        'IMPORT_TRACK', 'IMPORT_EVENT_NEW', 'IMPORT_TRACK_NEW', 'IMPORT_EVENT_EXISTING',
        'IMPORT_CREATED_EVENTS', 'IMPORT_CREATED_TRACKS', 'IMPORT_SEASON_PENDING',
        'IMPORT_DUPLICATE_REVIEW', 'IMPORT_DUPLICATE_DECISION', 'IMPORT_DUPLICATE_CHANGED',
        'IMPORT_KEEP_DISTINCT', 'IMPORT_EXISTING', 'IMPORT_INCOMING', 'IMPORT_IN_FILE',
        'IMPORT_DUPLICATE_HIDDEN', 'IMPORT_SPLITS', 'IMPORT_SOURCE', 'IMPORT_REFERENCE',
        'IMPORT_CLUB_EXCLUDED', 'IMPORT_CLUB_CHANGED', 'IMPORT_CLUB_CHOOSE',
        'IMPORT_CATEGORY_UPDATE_CHOOSE', 'IMPORT_CATEGORY_UPDATE_YES', 'IMPORT_CATEGORY_UPDATE_NO',
        'IMPORT_CATEGORY_UPDATE_CONFLICT', 'IMPORT_CATEGORY_CURRENT',
        'IMPORT_CATEGORY_CHANGED', 'IMPORT_UPDATED_SKATERS',
        'IMPORT_CLUB_NEW', 'IMPORT_CLUB_PROFILE', 'IMPORT_CLUB_FILE', 'IMPORT_CREATED_CLUBS',
        'COL_race', 'COL_distance', 'COL_totalTime', 'COL_category', 'COL_rail', 'COL_starting',
        'MODEL_Skater', 'COL_club'
    ].map(key => [key, __(key)]))).replace(/</g, '\\u003c') %>;
</script>
<script src="/js/registry-import.js"></script>
