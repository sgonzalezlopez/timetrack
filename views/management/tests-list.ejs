<link rel="stylesheet" href="/bootstrap-table/bootstrap-table.min.css">
<div class="card">
	<div class="card-body">
		<h5 class="card-title"><%= __('Tests') %></h5>
		<div class="row g-3 align-items-end">
			<div class="col-md-5">
				<label for="raceFilter" class="form-label"><%= __('COL_race') %></label>
				<select id="raceFilter" class="form-select">
					<option value=""><%= __('All') %></option>
				</select>
			</div>
			<div class="col-md-3">
				<label for="distanceFilter" class="form-label"><%= __('COL_distance') %></label>
				<select id="distanceFilter" class="form-select">
					<option value=""><%= __('All') %></option>
				</select>
			</div>
			<div class="col-md-4 d-flex gap-2">
				<button type="button" id="filterBtn" class="btn btn-dark"><%= __('FILTER') %></button>
				<button type="button" id="clearBtn" class="btn btn-secondary"><%= __('CLEAR_FILTERS') %></button>
			</div>
		</div>
	</div>
</div>

<div class="card">
	<div class="card-body">
		<div class="table-responsive">
			<table id="table" data-toggle="table" data-sortable="true" class="table table-striped table-bordered">
				<thead>
					<tr>
						<% if (locals.permissions.includes('U')) { %>
						<th data-checkbox="true" data-checkbox-enabled="true"></th>
						<% } %>
						<th data-field="race" data-sortable="true">
							<%= __('COL_race') %>
						</th>
						<th data-field="distance" data-sortable="true" data-formatter="distanceFormatter">
							<%= __('COL_distance') %>
						</th>
						<th data-field="competitionsCount" data-sortable="true">
							<%= __('COL_competitionsCount') %>
						</th>
						<th data-field="registriesCount" data-sortable="true">
							<%= __('COL_registriesCount') %>
						</th>
						<th data-field="actions" data-formatter="actionFormatter" data-align="center" data-events="actionEvents">
							<%= __('COL_actions') %>
						</th>
					</tr>
				</thead>
			</table>
		</div>
	</div>
</div>

<div class="modal fade" id="RaceEditModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title"><%= __('EDIT_RACE') %></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div class="mb-3">
					<label for="editRace" class="form-label"><%= __('COL_race') %></label>
					<input type="text" id="editRace" class="form-control">
				</div>
				<div class="mb-3">
					<label for="editDistance" class="form-label"><%= __('COL_distance') %></label>
					<input type="number" id="editDistance" class="form-control" min="0" step="1">
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= __('CLOSE') %></button>
				<button type="button" id="saveRaceBtn" class="btn btn-primary"><%= __('SAVE') %></button>
			</div>
		</div>
	</div>
</div>

<script>
	var editModal = null;
	var currentRaceRow = null;

	function normalizeDistance(value) {
		return value === '' || value == null ? '' : String(value);
	}

	function distanceFormatter(value) {
		if (window.core && core.formatters && typeof core.formatters.distance === 'function') {
			return core.formatters.distance(value);
		}
		return value;
	}

	function notify(type, message) {
		if (window.toastr && typeof toastr[type] === 'function') {
			toastr[type](message, core.options.localized.APP_NAME);
			return;
		}

		if (type === 'error') {
			console.error(message);
			return;
		}

		console.log(message);
	}

	function getFilters() {
		return {
			race: $('#raceFilter').val(),
			distance: $('#distanceFilter').val()
		};
	}

	function fillSelect($select, values, selectedValue) {
		const currentValue = selectedValue != null ? String(selectedValue) : String($select.val() || '');
		$select.find('option:not(:first)').remove();
		values.forEach(value => {
			$select.append($('<option></option>').val(value).text(value));
		});
		$select.val(currentValue);
	}

	function loadOptions() {
		return $.getJSON('/api/registry/races/options', function(data) {
			fillSelect($('#raceFilter'), data.races || []);
			fillSelect($('#distanceFilter'), (data.distances || []).map(value => normalizeDistance(value)));
		});
	}

	function loadTable() {
		$.ajax({
			type: 'POST',
			url: '/api/registry/races/find',
			data: getFilters(),
			dataType: 'json',
			success: function(data) {
				$('#table').bootstrapTable('load', data);
			},
			error: function(error) {
				console.error(error);
				notify('error', '<%= __('LOAD_TESTS_ERROR') %>');
			}
		});
	}

	function actionFormatter(value, row, index) {
		return [
			'<%- permissions.includes("U") ? `<a class="edit" href="javascript:void(0)" title="${__("EDIT_RACE")}"><i class="fa fa-edit"></i></a> <a class="merge" href="javascript:void(0)" title="${__("MERGE_RACES")}"><i class="fa fa-compress"></i></a>` : `` %>'
		].join('');
	}

	function openEditModal(row) {
		currentRaceRow = row;
		$('#editRace').val(row.race || '');
		$('#editDistance').val(row.distance != null ? row.distance : '');
		if (!editModal) {
			editModal = new bootstrap.Modal(document.getElementById('RaceEditModal'));
		}
		editModal.show();
	}

	function mergeInto(row) {
		const selectedRows = $('#table').bootstrapTable('getSelections').filter(item => {
			return !(item.race === row.race && normalizeDistance(item.distance) === normalizeDistance(row.distance));
		});

		if (selectedRows.length === 0) {
			notify('warning', '<%= __('SELECT_RACES_TO_MERGE') %>');
			return;
		}

		$.ajax({
			type: 'POST',
			url: '/api/registry/races/merge',
			contentType: 'application/json',
			data: JSON.stringify({
				targetRace: row.race,
				targetDistance: row.distance,
				sources: selectedRows.map(item => ({ race: item.race, distance: item.distance }))
			}),
			dataType: 'json',
			success: function() {
				notify('success', '<%= __('RACE_MERGE_SUCCESS') %>');
				$('#table').bootstrapTable('uncheckAll');
				loadOptions().then(loadTable);
			},
			error: function(error) {
				console.error(error);
				notify('error', '<%= __('RACE_MERGE_ERROR') %>');
			}
		});
	}

	window.actionEvents = {
		'click .edit': function(e, value, row) {
			e.stopPropagation();
			openEditModal(row);
		},
		'click .merge': function(e, value, row) {
			e.stopPropagation();
			mergeInto(row);
		}
	};

	$('#filterBtn').on('click', function() {
		loadTable();
	});

	$('#clearBtn').on('click', function() {
		$('#raceFilter').val('');
		$('#distanceFilter').val('');
		loadTable();
	});

	$('#saveRaceBtn').on('click', function() {
		if (!currentRaceRow) return;

		$.ajax({
			type: 'PUT',
			url: '/api/registry/races',
			data: {
				currentRace: currentRaceRow.race,
				currentDistance: currentRaceRow.distance,
				race: $('#editRace').val(),
				distance: $('#editDistance').val()
			},
			dataType: 'json',
			success: function() {
				notify('success', '<%= __('RACE_UPDATE_SUCCESS') %>');
				if (editModal) editModal.hide();
				loadOptions().then(loadTable);
			},
			error: function(error) {
				console.error(error);
				notify('error', '<%= __('RACE_UPDATE_ERROR') %>');
			}
		});
	});

	$(document).ready(function() {
		loadOptions().then(loadTable);
	});
</script>